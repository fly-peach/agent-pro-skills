# ── OSS 路线：开源服务端（langgraph dev）+ 自定义 Postgres checkpointer ──
# 优点：不需要 LangSmith API Key / 商业 license
# 说明：inmem 版服务端的线程/运行元数据仍写本地 .langgraph_api 目录（compose 已挂卷持久化），
#       而会话内容（checkpoints：消息 / todos / 文件）落到 PostgreSQL。
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_SYSTEM_PYTHON=1

RUN pip install --no-cache-dir uv

WORKDIR /app/backend
COPY pyproject.toml ./
COPY agent.py api.py checkpointer.py langgraph.json langfuse_setup.py ./

# 开源服务端（inmem edition）+ 项目依赖（含 langgraph-checkpoint-postgres）
RUN uv pip install --system --no-cache-dir "langgraph-cli[inmem]" -e .

# inmem 版的 op 记录（线程/运行元数据）落盘目录，compose 会挂 volume 持久化
RUN mkdir -p /app/backend/.langgraph_api

EXPOSE 8000
CMD ["langgraph", "dev", "--host", "0.0.0.0", "--port", "8000", "--no-browser", "--no-reload"]
